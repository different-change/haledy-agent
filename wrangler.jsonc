{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "haledy-agent",
  "account_id": "2fa116408a86d801aded444ebfdcb9dd",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [{ "binding": "DB", "database_name": "haledy-agent", "database_id": "03b018b3-b90d-42f5-80fd-219c53dfaf28", "migrations_dir": "migrations" }],
  // Namespace ids are account-wide: 1001 is the site's SIGNUP_LIMITER, so these use 2001-2003.
  "ratelimits": [
    { "name": "VAULT_IP_LIMITER", "namespace_id": "2001", "simple": { "limit": 10, "period": 60 } },
    { "name": "STEP_IP_LIMITER", "namespace_id": "2002", "simple": { "limit": 30, "period": 60 } },
    { "name": "STEP_VAULT_LIMITER", "namespace_id": "2003", "simple": { "limit": 20, "period": 60 } }
  ],
  "vars": { "MODEL": "claude-opus-5-5" },
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
